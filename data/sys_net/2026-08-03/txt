	第一个参数：表示套接子文件描述符
	第二个参数：表示级别
		IPPROTO_IP  ： 表示ipv4级别   多播用就是这个级别
	第三个参数：操作指令
		IP_ADD_MEMBERSHIP
		struct ip_mreqn {
			//表示多播号 224.1.2.3
			struct in_addr imr_multiaddr; /* IP multicast group
											 address */
			//表示用户ip	 ifconfig 							 
			struct in_addr imr_address;   /* IP address of local
											 interface */
			//小标 0								 
			int            imr_ifindex;   /* interface index */
		};

	第四个参数：表示添加结构体信息
	第五个结束：表示结构体大小

io复用
	int select(int nfds, fd_set *readfds, fd_set *writefds,
			fd_set *exceptfds, struct timeval *timeout);
		第一个参数：表示打开文件描述符最大值 + 1
		第二个参数：表示文件描述符读集 NULL
		第三个参数：表示文件描述符写集 NULL
		第四个参数：表示文件描述符异常集合 NULL
		第五个参数：表示时间结构体
			默认是阻塞等待文件描述符状态
			struct timeval {
				long    tv_sec;         /* seconds */
				long    tv_usec;        /* microseconds */
			};
			时间设置位0 ，则默认是轮寻的方接受用户
			时间设置为有效时间，则以等到设置时间检测用户信息
			NULL ：   睡眠的方式等到用户输入
	返回值：
		成功：返回文件描述符个数（用户数）
		0 ： 表示超时
		-1 : 表示失败


	void FD_CLR(int fd, fd_set *set); //从文件描述符集合中删除
	int  FD_ISSET(int fd, fd_set *set);//判断文件描述符是否在集合中
	void FD_SET(int fd, fd_set *set);  //添加文件描述符到集合中
	void FD_ZERO(fd_set *set); //清空文件描述符集合




	

































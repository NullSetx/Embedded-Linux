	struct rlimit {
		rlim_t rlim_cur;  /* Soft limit */ 软资源限额
		rlim_t rlim_max;  /* Hard limit (ceiling for rlim_cur) */硬资源限额
	};
	返回值：
		成功：0
		失败：-1
	int setrlimit(int resource, const struct rlimit *rlim);
	

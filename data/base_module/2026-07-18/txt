单项链表
	struct list_t{
		int data;				//数据域 保存用户输入数据
		struct list_t *next;	//指针域 用于指向下一个节点的地址
	};



双向链表
struct list_t{
	int data;			//数据域 保存数据
	//指针域
	struct list_t *next;//指向下一个节点地址
	struct list_t *prev;//指向上一个节点地址
};







